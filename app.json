{
  "expo": {
    "name": "VetoID",
    "slug": "vetoid",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nz.vetoid.scanner",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "VetoID uses the camera strictly in memory to verify 18+ age eligibility under NZ law. Zero photos or personal data are ever stored.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "nz.vetoid.scanner",
      "versionCode": 3,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "baseUrl": "/_vetoid"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "VetoID uses the camera strictly in memory to verify 18+ age eligibility. Zero images or personal details are saved."
        }
      ],
      "expo-observe"
    ],
    "extra": {
      "eas": {
        "projectId": "d185c95d-27dd-4376-b5e7-6a90f2426189"
      }
    },
    "owner": "codebynikko"
  }
}
